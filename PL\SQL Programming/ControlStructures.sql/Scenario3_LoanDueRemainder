BEGIN
    FOR l IN (
        SELECT LoanID,
               CustomerID,
               EndDate
        FROM Loans
        WHERE EndDate BETWEEN SYSDATE AND SYSDATE + 30
    )
    LOOP
        DBMS_OUTPUT.PUT_LINE(
            'Reminder: Customer '
            || l.CustomerID ||
            ' has a loan due on '
            || TO_CHAR(l.EndDate,'DD-MON-YYYY')
        );
    END LOOP;
END;
/
